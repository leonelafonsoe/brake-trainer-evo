root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Real fixtures are evidence: preserve their exact bytes, including trailing spaces and the
# absence of a final newline.
[tests/fixtures/**]
insert_final_newline = false
trim_trailing_whitespace = false
