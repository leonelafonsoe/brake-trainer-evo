root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Real game-log fixtures are evidence: preserve their trailing spaces.
[tests/fixtures/game_log/*.txt]
trim_trailing_whitespace = false
